{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "runbook-search"
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app": "runbook-search"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "runbook-search"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "app",
            "image": "example/runbook-search:1.0.0",
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 8000
              }
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 8000
              }
            },
            "securityContext": {
              "runAsNonRoot": true,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true
            }
          }
        ]
      }
    }
  }
}